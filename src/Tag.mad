import type { Comparison } from "Compare"
import type { Maybe } from "Maybe"

import { EQ, GT, LT } from "Compare"
import Float from "Float"
import Fn from "Function"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import {} from "Monad"
import String from "String"
import Tuple from "Tuple"

import _List from "@/List"



lower = map(String.toLower)
export type Tag = NoTag | Tag(List String)
instance Comparable Tag {
  compare = compareTag
}
create :: List String -> Tag
export create = Tag
many :: List (List String) -> List Tag
export many = map(create)
_alphasortString :: String -> String -> Comparison
export _alphasortString = (x, y) => {
  checker = (c, ax, bx) => where(#[ax, bx]) {
    #[[a1, ...as], [b1, ...bs]] =>
      if (a1 == b1) {
        checker(EQ, as, bs)
      } else {
        a1 < b1 ? LT : GT
      }

    #[[a1, ...as], []] =>
      LT

    #[[], [a1, ...as]] =>
      GT

    #[[], []] =>
      c
  }
  return checker(EQ, String.toList(x), String.toList(y))
}
export _compareLists = (ax, bx) => {
  abcompare = where {
    #[Just(a), Just(b)] =>
      Just(_alphasortString(a, b))

    #[Just(_), _] =>
      Just(GT)

    #[_, Just(_)] =>
      Just(LT)

    _ =>
      Nothing
  }
  inner = (list) => where(list) {
    [] =>
      // really just for coverage
      abcompare(#[Nothing, Nothing])

    [p, ...ps] =>
      abcompare(p)
  }

  return pipe(
    _List.diverge(ax),
    inner,
    fromMaybe(EQ),
  )(bx)
}
compareTag :: Tag -> Tag -> Comparison
export compareTag = (a, b) => where(#[a, b]) {
  #[Tag(_a), NoTag] =>
    GT

  #[Tag(_a), Tag(_b)] =>
    _compareLists(_a, _b)

  #[NoTag, Tag(_b)] =>
    LT

  _ =>
    EQ
}
// FIELDS

toList :: Tag -> List String
export toList = where {
  Tag(x) =>
    x

  NoTag =>
    []
}
_enscope :: (List String -> a) -> Tag -> a
export _enscope = (fn, x) => pipe(
  toList,
  fn,
)(x)
render :: Tag -> String
export render = _enscope(String.join(":"))
length :: Tag -> Integer
export length = _enscope(List.length)
root :: Tag -> Maybe String
export root = _enscope(List.first)
focus :: Tag -> Maybe String
export focus = _enscope(List.last)
scopeAt :: Integer -> Tag -> Maybe String
export scopeAt = (i, t) => _enscope(List.nth(i))(t)
// DERIVATIONS

isBand :: Tag -> Boolean
export isBand = pipe(
  toList,
  List.length,
  (x) => x == 1,
)
isRootSibling :: Tag -> Tag -> Boolean
export isRootSibling = (a, b) => root(a) == root(b)
equalPair = where {
  #[k, v] =>
    k == v
}
isRelative :: Tag -> Tag -> Boolean
export isRelative = (_a, _b) => where(#[_a, _b]) {
  #[Tag(a), Tag(b)] =>
    pipe(
      List.zip(a),
      List.any(equalPair),
    )(b)

  _ =>
    false
}
fold :: (a -> List a -> Boolean) -> Tag -> Tag -> List String
export fold = (comp, a, b) => where(#[a, b]) {
  #[Tag(xs), Tag(ys)] =>
    List.reduce(
      (agg, y) => comp(String.toLower(y), lower(xs)) ? List.concat(agg, [y]) : agg,
      [],
      lower(ys),
    )

  #[Tag(x), _] =>
    x

  #[_, Tag(x)] =>
    x

  _ =>
    []
}
overlap :: Tag -> Tag -> List String
export overlap = fold(List.includes)
difference :: Tag -> Tag -> List String
export difference = fold((a, b) => Fn.complement(List.includes(a))(b))
affinity :: Tag -> Tag -> Float
export affinity = (_a, _b) => {
  dA = length(_a)
  dB = length(_b)
  d = dA > dB ? dA : dB
  n = pipe(
    overlap(_a),
    List.length,
  )(_b)
  return n / d
}
equals :: Tag -> Tag -> Boolean
export equals = (_a, _b) => affinity(_a, _b) == 1
relate :: List Tag -> Tag -> List Float
export relate = (ts, t) => List.reduce(
  (agg, u) => pipe(
    List.append(affinity(t, u)),
  )(agg),
  [],
  ts,
)
relateTags :: List Tag -> Tag -> List Tag
export relateTags = (ts, t) => pipe(
  relate(ts),
  List.zip($, ts),
  List.filter(
    pipe(
      Tuple.fst,
      (z) => z > 0,
    ),
  ),
  map(Tuple.snd),
)(t)
relateManyTags :: List Tag -> List Tag -> List (List Tag)
export relateManyTags = (xs, ys) => map(relateTags(xs), ys)
