import type { Comparison } from "Compare"

import type { Tag } from "@/Tag"

import { EQ, GT, LT } from "Compare"
import List from "List"
import { Just, Nothing } from "Maybe"
import String from "String"

import Tag from "@/Tag"



// tag queries allow us to have modifiers to the base tag logic
export type TagQuery = NoTags | ExactQuery(Tag) | InvertQuery(Tag) | AnyTag
// Tagged stuff can have many query tags to a single shared value
export type Tagged a = Tagged(List TagQuery, a)
// CONSTRUCTORS

export createExact = pipe(
  Tag.Tag,
  ExactQuery,
)
// simple constructor allows us to go from strings to a Tagged item
tagged :: List (List String) -> a -> Tagged a
export tagged = pipe(
  map(createExact),
  Tagged,
)
export stripQuery = where {
  ExactQuery(x) =>
    x

  InvertQuery(x) =>
    x

  _ =>
    Tag.NoTag
}
export mapQuery = (fn, xx) => where(xx) {
  ExactQuery(x) =>
    ExactQuery(fn(x))

  InvertQuery(x) =>
    InvertQuery(fn(x))

  _ =>
    xx
}
queries :: Tagged a -> List TagQuery
export queries = where {
  Tagged(q, _) =>
    q
}
mapQueries :: (List TagQuery -> List TagQuery) -> Tagged a -> Tagged a
export mapQueries = (fn, x) => where(x) {
  Tagged(a, b) =>
    Tagged(fn(a), b)
}
subject :: Tagged a -> a
export subject = where {
  Tagged(_, s) =>
    s
}
matchPredicate = (match, s, qq) => where(qq) {
  NoTags =>
    false

  AnyTag =>
    true

  ExactQuery(uu) =>
    match(uu, s)

  InvertQuery(uu) =>
    !match(uu, s)
}
checkMatch = matchPredicate(
  (uu, s) => where(uu) {
    Tag.Tag(u2) =>
      pipe(
        map(String.toLower),
        List.includes(String.toLower(s)),
      )(u2)

    Tag.NoTag =>
      false
  },
)
export fuzzy = (s, tgd) => pipe(
  queries,
  List.filter(checkMatch(s)),
)(tgd)
isPrefixOf = (pattern, mTag) => where(mTag) {
  Tag.Tag(tag) =>
    do {
      n = List.length(pattern)
      return List.length(tag) >= n && List.take(n, tag) == pattern
    }

  _ =>
    false
}
claims = (qq, tag) => where(qq) {
  ExactQuery(Tag.Tag(segments)) =>
    isPrefixOf(segments, tag)

  ExactQuery(_) =>
    false

  InvertQuery(Tag.Tag(segments)) =>
    isPrefixOf(segments, tag)

  InvertQuery(_) =>
    false

  AnyTag =>
    true

  NoTags =>
    false
}
appliesTo = where {
  ExactQuery(_) =>
    true

  InvertQuery(_) =>
    false

  AnyTag =>
    true

  NoTags =>
    false
}
enabled :: Tagged a -> Tag -> Boolean
enabled = (tgd, tag) => pipe(
  queries,
  List.find(claims($, tag)),
  where {
    Just(q) =>
      appliesTo(q)

    Nothing =>
      false
  },
)(tgd)
filter :: List (Tagged a) -> Tag -> List (Tagged a)
export filter = (tagLib, queryTag) => List.filter(enabled($, queryTag), tagLib)
