import type { Comparison } from "Compare"

import type { Tag } from "@/Tag"

import { EQ, GT, LT } from "Compare"

import Tag from "@/Tag"



// Tagged stuff can have many tags to a single shared value
export type TagMod = NoMod(Tag) | Invert(Tag) | AnyTag | NoneTag | AllTag
export type Tagged a = Tagged(List TagMod, a)
// matching allows us to 
// CONSTRUCTORS

export tagged = pipe(
  map(
    pipe(
      Tag.Tag,
      NoMod,
    ),
  ),
  Tagged,
)
export stripMod = where {
  NoMod(x) =>
    x

  Invert(x) =>
    x

  _ =>
    Tag.NoTag
}
export mapMod = (fn, xx) => where(xx) {
  NoMod(x) =>
    NoMod(fn(x))

  Invert(x) =>
    Invert(fn(x))

  _ =>
    xx
}
tags :: Tagged a -> List TagMod
export tags = where {
  Tagged(t, _) =>
    t
}
export mapTags = (fn, x) => where(x) {
  Tagged(a, b) =>
    Tagged(fn(a), b)
}
subject :: Tagged a -> a
export subject = where {
  Tagged(_, s) =>
    s
}
export alias Relationship = {
  affinity :: Float,
  isRelative :: Boolean,
  isRootRelative :: Boolean,
  overlap :: List String,
}

