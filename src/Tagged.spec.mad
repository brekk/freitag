// import type { } from "@/Tagged"

import { caseN2, report } from "Study"

import Tag from "@/Tag"
import Q from "@/Tagged"



HARNESS = {
  STRINGS: [
    ["city", "San Francisco"],
    ["shop", "bakery", "Tartine"],
    ["pastry", "croissant"],
    ["pastry", "morning bun"],
    ["bread"],
    ["pastry"],
  ],
  TAGS: [
    Tag.create(["city", "San Francisco"]),
    Tag.create(["shop", "bakery", "Tartine"]),
    Tag.create(["pastry", "croissant"]),
    Tag.create(["pastry", "morning bun"]),
    Tag.create(["bread"]),
    Tag.create(["pastry"]),
  ],
  ENTITY: {
    name: "Tartine",
    location: "San Francisco",
    description: "Fantastic croissants and morning buns",
  },
}
ASSEMBLED = Q.tagged(HARNESS.STRINGS, HARNESS.ENTITY)
report(Q.subject, "subject", [#[ASSEMBLED, HARNESS.ENTITY]])

