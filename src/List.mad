import type { Maybe } from "Maybe"

import Fn from "Function"
import List from "List"
import { Just, Nothing } from "Maybe"



divergeBy :: Eq a => (a -> b -> Boolean) -> List a -> List b -> List #[Maybe a, Maybe b]
export divergeBy = (equality, ax, bx) => {
  branch = (cs, as, bs) => {
    add = List.concat(cs)
    return where(#[as, bs]) {
      #[[a, ...aa], [b, ...bb]] =>
        pipe(
          add,
          branch($, aa, bb),
        )(equality(a, b) ? [] : [#[Just(a), Just(b)]])

      #[[a, ...aa], []] =>
        pipe(
          add,
          branch($, aa, []),
        )([#[Just(a), Nothing]])

      #[[], [b, ...bb]] =>
        pipe(
          add,
          branch($, [], bb),
        )([#[Nothing, Just(b)]])

      #[_, _] =>
        cs
    }
  }
  return branch([], ax, bx)
}
export diverge = divergeBy(Fn.equals)
