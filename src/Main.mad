import IO from "IO"
import String from "String"

import CopyEdit from "CopyEdit"

import { Tag, isRootSibling, overlap, render } from "@/Tag"



main = () => {
  smork = Tag(["smork", "flugtag", "config"])
  name = Tag(["flugtag", "config", "common", "name"])
  pipe(
    isRootSibling(smork),
    IO.pTrace("siblings"),
  )(name)

  pipe(
    overlap(smork),
    IO.pTrace("overlap"),
    String.join(":"),
    IO.pTrace("joint"),
    CopyEdit.distance(render(smork)),
    IO.pTrace("distance"),
  )(name)
}
