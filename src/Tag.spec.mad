import type { Comparison } from "Compare"

import { EQ, GT, LT } from "Compare"
import List from "List"
import { Just } from "Maybe"
import Set from "Set"
import String from "String"
import { assertEquals, test } from "Test"

import Study from "Study"

import {
  NoTag,
  Tag,
  _alphasortString,
  affinity,
  compareTag,
  create,
  difference,
  focus,
  isBand,
  isRelative,
  isRootSibling,
  length,
  many,
  overlap,
  relate,
  relateManyTags,
  relateTags,
  render,
  root,
  scopeAt,
  toList,
} from "@/Tag"



test(
  "lettercompare",
  () => {
    return assertEquals(
      List.sortBy(
        _alphasortString,
        pipe(
          String.split(""),
          map(String.trim),
          List.reject(String.isEmpty),
          Set.fromList,
          Set.toList,
        )("the quick brown fox jumps over the lazy dog"),
      ),
      String.split("", "abcdefghijklmnopqrstuvwxyz"),
    )
  },
)
Study.report(
  List.sortBy(compareTag),
  "compareTag sorts correctly",
  [
    #[
      [NoTag, Tag(["b"]), Tag(["b", "c"]), NoTag, Tag(["a"]), Tag(["a", "b"])],
      [NoTag, NoTag, Tag(["a"]), Tag(["a", "b"]), Tag(["b"]), Tag(["b", "c"])],
    ],
  ],
)
Study.report(
  where {
    #[a, b] =>
      a < b
  },
  "chars have a default comparability?",
  [#[#['a', 'b'], true], #[#['b', 'c'], true], #[#['a', 'c'], true]],
)
alias Laws = { antisymmetric :: Boolean, reflexive :: Boolean, transitive :: Boolean }
validateCompare :: (a -> a -> Comparison) -> a -> a -> a -> Laws
validateCompare = (check, a, b, c) => {
  aa = check(a, a)
  bb = check(b, b)
  cc = check(c, c)

  ab = check(a, b)
  ba = check(b, a)


  refA = aa == EQ
  refB = bb == EQ
  refC = cc == EQ
  reflexive = refA && refB && refC

  antisymmetric = if (ab == EQ) {
    ab == ba
  } else if (ab == GT) {
    ba == LT
  } else {
    ba == GT
  }
  transitive = if (ab == ba) do {
    ac = check(a, c)
    return ab == ac && ba == ac
  } else {
    true
  }
  return { reflexive, antisymmetric, transitive }
}
checkCompare :: (a -> a -> Comparison) -> a -> a -> a -> Boolean
export checkCompare = (check, a, b, c) => where(validateCompare(check, a, b, c)) {
  { reflexive, antisymmetric, transitive } =>
    reflexive && antisymmetric && transitive
}
VALID = { antisymmetric: true, reflexive: true, transitive: true }
validateComparisonAlgo = (x) => Study.report(Study.caseN3(validateCompare(x)))
validateComparisonAlgo(compareTag)(
  "ensure compareTag is a valid comparison algo",
  [
    #[#[create(["blah"]), create(["claw"]), create(["baw"])], VALID],
    #[#[create(["blah"]), create(["blah", "blah"]), create(["blah", "nah"])], VALID],
  ],
)
validateComparisonAlgo(_alphasortString)(
  "ensure alphasortString is a valid comparison algo",
  [
    #[#["a", "b", "c"], VALID],
    #[#["", "b", "c"], VALID],
    #[#["ab", "bc", "cd"], VALID],
    #[#["aa", "ab", "ac"], VALID],
    #[#["b", "a", "c"], VALID],
    #[#["astro", "casper", "bastard"], VALID],
  ],
)
HARNESS = {
  a: create(["a"]),
  abc: create(["a", "b", "c"]),
  abcd: create(["a", "b", "c", "d"]),
  skibidi: create(["skibidi"]),
  cdef: create(["c", "d", "e", "f"]),
}
TARTINE = [
  ["location", "city", "San Francisco"],
  ["location", "neighborhood", "The Mission"],
  ["shop", "bakery", "Tartine"],
  ["shop", "food", "on-site"],
  ["baked", "pastry", "croissant"],
  ["baked", "pastry", "morning bun"],
  ["baked", "bread", "sourdough"],
  ["pastry"],
  ["bread"],
  ["near", "Dolores Park"],
]
Study.report(create, "create", [#[["skibidi"], HARNESS.skibidi]])
Study.report(
  Study.caseN2(isRelative),
  "isRelative",
  [
    #[#[HARNESS.abc, HARNESS.abcd], true],
    #[#[HARNESS.abc, HARNESS.a], true],
    #[#[NoTag, HARNESS.abcd], false],
    #[#[HARNESS.abc, NoTag], false],
  ],
)
Study.report(
  Study.caseN2(isRootSibling),
  "isRootSibling",
  [#[#[HARNESS.abc, HARNESS.abcd], true], #[#[HARNESS.abc, HARNESS.a], true]],
)
Study.report(length, "length", [#[HARNESS.abcd, 4], #[HARNESS.a, 1]])
Study.report(isBand, "isBand", [#[HARNESS.a, true], #[HARNESS.abcd, false]])
Study.report(scopeAt(2), "scopeAt", [#[HARNESS.abcd, Just("c")]])
Study.report(
  toList,
  "toList",
  [#[HARNESS.abcd, ["a", "b", "c", "d"]], #[HARNESS.abc, ["a", "b", "c"]], #[NoTag, []]],
)
Study.report(render, "render", [#[HARNESS.abcd, "a:b:c:d"], #[HARNESS.a, "a"]])
Study.report(root, "root", [#[HARNESS.abcd, Just("a")], #[HARNESS.a, Just("a")]])
Study.report(focus, "focus", [#[HARNESS.abcd, Just("d")], #[HARNESS.a, Just("a")]])
Study.report(
  Study.caseN2(overlap),
  "overlap",
  [
    #[#[HARNESS.abcd, HARNESS.a], ["a"]],
    #[#[HARNESS.abcd, HARNESS.abc], ["a", "b", "c"]],
    #[#[HARNESS.a, HARNESS.skibidi], []],
  ],
)
Study.report(
  Study.caseN2(affinity),
  "affinity - let's test some stuff and see what makes sense",
  [
    #[#[HARNESS.abcd, HARNESS.a], 0.25],
    #[#[HARNESS.a, HARNESS.abcd], 0.25],
    #[#[HARNESS.skibidi, HARNESS.abcd], 0],
    #[#[HARNESS.skibidi, HARNESS.skibidi], 1],
    #[#[HARNESS.cdef, HARNESS.abcd], 0.5],
  ],
)
Study.report(
  Study.caseN2(compareTag),
  "compareTag",
  [
    #[#[HARNESS.abcd, HARNESS.a], GT],
    #[#[HARNESS.a, HARNESS.abcd], LT],
    #[#[HARNESS.abcd, HARNESS.abcd], EQ],
    #[#[HARNESS.abc, HARNESS.abcd], LT],
    #[#[HARNESS.abcd, HARNESS.abc], GT],
    #[#[HARNESS.skibidi, HARNESS.abc], GT],
    #[#[HARNESS.abc, HARNESS.skibidi], LT],
    #[#[HARNESS.a, HARNESS.skibidi], LT],
  ],
)
test(
  "compare",
  () => do {
    assertEquals(HARNESS.a < HARNESS.skibidi, true)
    return assertEquals(HARNESS.abcd < HARNESS.a, false)
  },
)
Study.report(
  many,
  "many",
  [
    #[[], []],
    #[
      TARTINE,
      [
        Tag(["location", "city", "San Francisco"]),
        Tag(["location", "neighborhood", "The Mission"]),
        Tag(["shop", "bakery", "Tartine"]),
        Tag(["shop", "food", "on-site"]),
        Tag(["baked", "pastry", "croissant"]),
        Tag(["baked", "pastry", "morning bun"]),
        Tag(["baked", "bread", "sourdough"]),
        Tag(["pastry"]),
        Tag(["bread"]),
        Tag(["near", "Dolores Park"]),
      ],
    ],
  ],
)
Study.report(
  relate(many(TARTINE)),
  "relate",
  [#[Tag(["shop", "bakery"]), [0, 0, 2 / 3, 1 / 3, 0, 0, 0, 0, 0, 0]]],
)
Study.report(
  difference(Tag(["a", "b", "c"])),
  "difference",
  [#[Tag(["a", "b", "d"]), ["d"]], #[NoTag, ["a", "b", "c"]]],
)
Study.report(
  difference(NoTag),
  "difference(NoTag)",
  [#[Tag(["a", "b", "d"]), ["a", "b", "d"]], #[NoTag, []]],
)
Study.report(
  relateTags(many(TARTINE)),
  "relateTags",
  [
    #[
      Tag(["shop", "bakery"]),
      [Tag(["shop", "bakery", "Tartine"]), Tag(["shop", "food", "on-site"])],
    ],
  ],
)
Study.report(
  relateManyTags(many(TARTINE)),
  "relateManyTags",
  [
    #[[], []],
    #[
      [
        Tag(["shop", "bakery"]),
        Tag(["location", "city", "Los Angeles"]),
        Tag(["neighborhood"]),
        Tag(["bread"]),
      ],
      [
        [Tag(["shop", "bakery", "Tartine"]), Tag(["shop", "food", "on-site"])],
        [
          Tag(["location", "city", "San Francisco"]),
          Tag(["location", "neighborhood", "The Mission"]),
        ],
        [Tag(["location", "neighborhood", "The Mission"])],
        [Tag(["baked", "bread", "sourdough"]), Tag(["bread"])],
      ],
    ],
  ],
)
